# IWT Stud Sensor - Configuration Template
# Copy this file to .env and update with your specific values
# DO NOT commit the .env file with credentials to git

# ==============================================================================
# SENSOR CONFIGURATION
# ==============================================================================
# GPIO pin number for inductive sensor (BCM numbering)
SENSOR_PIN=17

# Header/Machine identification
HEAD_NAME=CHANGE
HEAD_ID=0

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# MySQL database connection details
DB_HOST=192.168.1.54
DB_USER=webapp
DB_PASS=STUDS2650
DB_NAME=iwt_db

# ==============================================================================
# OPERATIONAL PARAMETERS
# ==============================================================================
# Work hours (24-hour format, uses >= start and < end)
# This example: logs data only between 7 AM and 5 PM
WORK_START=7
WORK_END=17

# How often to sync counts to database (in minutes)
SYNC_INTERVAL=1

# ==============================================================================
# LOGGING (Optional)
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (if not set, uses home directory)
# LOG_FILE=/var/log/sensor/sensor.log
