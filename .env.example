# IWT Stud Sensor - Configuration Template
# Copy this file to .env and update with your specific values
# DO NOT commit the .env file with credentials to git

# ==============================================================================
# SENSOR CONFIGURATION
# ==============================================================================
# GPIO pin number for inductive sensor (BCM numbering)
SENSOR_PIN=17

# Header/Machine identification
HEAD_NAME=CHANGE
HEAD_ID=0

# ==============================================================================
# CONNECT API
# ==============================================================================
# The sensor reports to connectCoreAPI and never touches the database.
API_URL=http://192.168.1.6:9090/api/v1

# This header's device token. Issued on the server with
#   bin/issue-header-token.php <HEAD_ID>
# and shown once - it is a credential: never commit it.
DEVICE_TOKEN=

# ==============================================================================
# OPERATIONAL PARAMETERS
# ==============================================================================
# Work hours (24-hour format, uses >= start and < end)
# This example: logs data only between 7 AM and 5 PM
WORK_START=7
WORK_END=17

# How often to report counts to Connect (in minutes)
SYNC_INTERVAL=1

# ==============================================================================
# LOGGING (Optional)
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (if not set, uses home directory)
# LOG_FILE=/var/log/sensor/sensor.log
